# Local demo only. Keep real credentials in your untracked env file.
AIRFLOW_UID=50000
LAKEHOUSE_DB_PASSWORD=lakehouse-demo-only
LAKEHOUSE_JWT_SECRET=lakehouse-demo-jwt-local-only
LAKEHOUSE_API_SECRET=lakehouse-demo-api-local-only
STORAGE_DEMO_MINIO_PASSWORD=storage-demo-local-only
LAKEHOUSE_AIRFLOW_PORT=28080
LAKEHOUSE_MOCK_PORT=28010
LAKEHOUSE_MINIO_PORT=29000
# Mutation is disabled until external writers for this namespace are stopped.
MAINTENANCE_ENABLED=false
MAINTENANCE_INGESTION_STOPPED=false
MAINTENANCE_FILE_THRESHOLD=2
MAINTENANCE_COOLDOWN_SECONDS=3600
# Empty means manual DAGs. Ingestion uses CronDataIntervalTimetable in UTC.
LAKEHOUSE_CRON_UTC=
MAINTENANCE_CRON_UTC=
